# App
APP_MODE=debug
APP_PORT=8080
APP_READ_TIMEOUT=30s
APP_WRITE_TIMEOUT=30s
APP_IDLE_TIMEOUT=30s
APP_REQUEST_TIMEOUT=30s
APP_MAX_PROCS=1000

# Authentication (password generation & jwt)
AUTH_PASSWORD_COST=10
AUTH_JWT_SECRET_KEY=secret_key
AUTH_JWT_ACCESS_TOKEN_TTL=360
AUTH_JWT_REFRESH_TOKEN_TTL=3600
AUTH_JWT_ISSUER=gin-box

# Log
LOG_LEVEL=4

# POSTGRES
POSTGRES_CONN_STRING=postgres://admin:admin@localhost:5432/gin-box

# GOOSE
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://admin:admin@localhost:5432/gin-box
GOOSE_MIGRATION_DIR=./migrations
